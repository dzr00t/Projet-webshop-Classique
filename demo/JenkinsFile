pipeline {
    agent any
    stages {
        stage('global stage') {
            agent {
                docker {
                    image 'maven:3.8.3-openjdk-17'
                    args '-u root --entrypoint='
                }
            }
            stages {
                    
                stage('clean allure results') {
                    steps {
                        sh '''
                            echo "Nettoyage des anciens résultats..."
                            rm -rf target/allure-results allure-results
                            mkdir -p target/allure-results
                        '''
                    }
                }

                stage('compile') {
                    steps {
                        sh 'mvn clean test-compile'
                    }
                }
        
                stage('run selenium grid tests') {
                    steps {   
                        script {
                            def seleniumGridUrl = "http://selenium-hub:4444/wd/hub"

                            sh "mvn test -Dselenium.grid.url=${seleniumGridUrl}"

                            stash name: 'allure-results', includes: '**/allure-results/*'
                        } 
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                try {
                    unstash 'allure-results'
                } catch (Exception e) {
                    echo "Erreur ou aucun stash trouvé: ${e.message}"
                }
                
                archiveArtifacts artifacts: '**/allure-results/*', allowEmptyArchive: true
                
                allure includeProperties: false,
                       jdk: '',
                       results: [[path: 'target/allure-results'], [path: 'allure-results']]
            }
        }
    } 
}